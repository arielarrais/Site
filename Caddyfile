{
	admin off
	auto_https disable_redirects
}

{$SITE_DOMAIN} {
	# O desafio do Let's Encrypt precisa passar sem senha e sem redirecionar.
	@redirect {
		not path /.well-known/acme-challenge/*
		not protocol https
	}
	redir @redirect https://{host}{uri} permanent

	basic_auth {
		{$SITE_BASIC_AUTH_USER} {$SITE_BASIC_AUTH_HASH}
	}

	encode zstd gzip
	reverse_proxy web:3001
}