# Copie este arquivo para .env (que NAO e versionado) e preencha os valores.
#   Windows:  copy .env.example .env
#   Git Bash: cp .env.example .env
#
# O docker-compose.yml le estas variaveis, e a aplicacao tambem carrega o .env
# quando roda fora do Docker (dotnet run). O .env e a unica fonte de segredos.

# ---- Banco de dados ----
POSTGRES_USER=postgres
POSTGRES_DB=site_db
# ATENCAO: trocar esta senha so funciona se o volume ja existir, depois:
#   docker exec -it site-db-1 psql -U postgres -c "ALTER USER postgres WITH PASSWORD 'nova_senha';"
POSTGRES_PASSWORD=troque_esta_senha

# ---- Segredo do JWT (OBRIGATORIO, minimo de 32 caracteres) ----
# Gere um valor aleatorio:  powershell -NoProfile -File scripts/gerar-jwt-secret.ps1
JWT_SECRET=

# ---- Endereco publico fixo (opcional, DDNS) ----
# Crie a conta em https://www.duckdns.org e copie o token da pagina inicial.
# DUCKDNS_DOMAIN e o subdominio escolhido (sem o .duckdns.org).
# Quem mantem tudo atualizado: scripts/atualizar-ddns.ps1 + scripts/instalar-tarefa-ddns.ps1
DUCKDNS_DOMAIN=
DUCKDNS_TOKEN=

# ---- Senha da porta de entrada (Caddy) ----
# asked pelo navegador antes de chegar na aplicacao.
# Gere o hash com:  docker compose exec proxy caddy hash-password --plaintext "senha"
# e escape cada $ como $$ (o Caddy le $ como variavel de ambiente).
SITE_BASIC_AUTH_USER=
SITE_BASIC_AUTH_HASH=

# ---- Tokens de terceiros (opcionais) ----
# Token do brapi.dev: cotacoes e importacao de acoes.
BRAPI_TOKEN=
# Chave do Google Sheets: leitura da planilha de precos (fica no servidor, nao no navegador).
GOOGLE_API_KEY=

# ---- Acesso ----
# false (padrao): ninguem cria conta sozinho,so o admin logado.
# true: a tela de login volta a oferecer "cadastrar-se" para qualquer visitante.
ALLOW_SELF_REGISTRATION=false

# ---- Somente para rodar a API fora do Docker (dotnet run) ----
# Dentro do Docker o host do banco e "db", definido pelo docker-compose.
ConnectionStrings__DefaultConnection=Host=localhost;Database=site_db;Username=postgres;Password=troque_esta_senha
